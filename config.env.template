# ============================================================================
# MFT Professional System - Configuration Template
# ============================================================================
# Copy this file to config.env and customize for your environment
#
# Linux: /etc/mft-system/config.env
# Windows: C:\ProgramData\MFT-System\config\config.env
# ============================================================================

# ----------------------------------------------------------------------------
# Flask Application Settings
# ----------------------------------------------------------------------------

# Secret key for session management (CHANGE THIS!)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-to-a-random-secret-key-minimum-32-characters

# Server binding
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Debug mode (set to False in production!)
FLASK_DEBUG=False

# ----------------------------------------------------------------------------
# Data Directory Paths
# ----------------------------------------------------------------------------

# Linux paths (default)
MFT_STATE_DIR=/var/lib/mft-system/state
MFT_USERS_DIR=/var/lib/mft-system/local_users
MFT_AUDIT_DIR=/var/lib/mft-system/audit
MFT_LOG_DIR=/var/log/mft-system

# Windows paths (uncomment if using Windows)
# MFT_STATE_DIR=C:\ProgramData\MFT-System\state
# MFT_USERS_DIR=C:\ProgramData\MFT-System\local_users
# MFT_AUDIT_DIR=C:\ProgramData\MFT-System\audit
# MFT_LOG_DIR=C:\ProgramData\MFT-System\logs

# ----------------------------------------------------------------------------
# Default Admin Account
# ----------------------------------------------------------------------------
# SECURITY WARNING: Change these immediately after installation!

MFT_ADMIN_USERNAME=sysadmin
MFT_ADMIN_PASSWORD=Admin@123

# ----------------------------------------------------------------------------
# Active Directory Configuration (Optional)
# ----------------------------------------------------------------------------
# Uncomment and configure if using Active Directory

# AD_SERVER=ldap://dc.company.com
# AD_PORT=389
# AD_BASE_DN=DC=company,DC=com
# AD_BIND_DN=CN=admin,DC=company,DC=com
# AD_BIND_PASSWORD=your-ad-password
# AD_USE_SSL=false
# AD_SYNC_INTERVAL=60

# ----------------------------------------------------------------------------
# File Transfer Settings
# ----------------------------------------------------------------------------

# Maximum file size for uploads (in MB)
MAX_UPLOAD_SIZE=1024

# Default file stability wait time (seconds)
DEFAULT_FILE_AGE=5

# Transfer retry attempts
TRANSFER_MAX_RETRIES=3

# Transfer timeout (seconds)
TRANSFER_TIMEOUT=300

# ----------------------------------------------------------------------------
# Compliance & Audit Settings
# ----------------------------------------------------------------------------

# Enable audit logging
AUDIT_ENABLED=true

# Audit log retention (days)
AUDIT_RETENTION_DAYS=90

# Enable compliance frameworks by default
COMPLIANCE_GDPR_ENABLED=true
COMPLIANCE_HIPAA_ENABLED=false
COMPLIANCE_SOX_ENABLED=false

# ----------------------------------------------------------------------------
# Security Settings
# ----------------------------------------------------------------------------

# Session timeout (minutes)
SESSION_TIMEOUT=30

# Password minimum length
PASSWORD_MIN_LENGTH=8

# Enable two-factor authentication (future feature)
# 2FA_ENABLED=false

# ----------------------------------------------------------------------------
# Email Notifications (Optional)
# ----------------------------------------------------------------------------
# Uncomment to enable email notifications for transfer events

# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=mft-system@yourcompany.com
# SMTP_USE_TLS=true

# ----------------------------------------------------------------------------
# Database Settings (Future Feature)
# ----------------------------------------------------------------------------
# Currently using JSON file storage
# Future releases may support PostgreSQL, MySQL, etc.

# DB_TYPE=sqlite
# DB_PATH=/var/lib/mft-system/mft.db

# ----------------------------------------------------------------------------
# Performance Tuning
# ----------------------------------------------------------------------------

# Worker threads for file monitoring
MONITOR_WORKER_THREADS=4

# Maximum concurrent transfers
MAX_CONCURRENT_TRANSFERS=10

# Monitoring poll interval (seconds)
MONITOR_POLL_INTERVAL=5

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Enable rotating logs
LOG_ROTATE=true
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# ----------------------------------------------------------------------------
# Advanced Settings
# ----------------------------------------------------------------------------

# Enable experimental features
EXPERIMENTAL_FEATURES=false

# API rate limiting (requests per minute)
API_RATE_LIMIT=60

# Timezone
TIMEZONE=UTC
